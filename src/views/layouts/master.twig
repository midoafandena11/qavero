{# Qavero - master layout (based on Salla Theme Raed, MIT) #}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}


    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = "{{ theme.settings.get('enable_more_menu', true) }}"
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', true) }}"
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}"
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <style id="qavero-style">
:root {
  --q-brand: #0f3d2e;
  --q-accent: #c8a45d;
  --q-ink: #14201a;
  --q-ivory: #f7f4ec;
  --q-sand: #ece6d6;
  --q-line: #e1d9c6;
  --q-muted: #665f50;
  --q-radius: 2px;
  --q-radius-lg: 18px;
  --q-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
}
body.qv-pal-noir { --q-brand: #111111; --q-accent: #c9a24d; --q-ink: #141414; --q-ivory: #f6f3ee; --q-sand: #ebe5da; --q-line: #ddd5c6; --q-muted: #6a655b; }
body.qv-pal-burgundy { --q-brand: #5b1424; --q-accent: #d4a76a; --q-ink: #1d0f13; --q-ivory: #faf5f1; --q-sand: #efe3da; --q-line: #e6d5c9; --q-muted: #6f5a55; }
body.qv-pal-navy { --q-brand: #14213d; --q-accent: #e0b76b; --q-ink: #0e1626; --q-ivory: #f5f6f8; --q-sand: #e6e9ef; --q-line: #d8dce5; --q-muted: #596073; }
body.qv-pal-terracotta { --q-brand: #8a3b24; --q-accent: #e9b872; --q-ink: #2a1710; --q-ivory: #fbf5ee; --q-sand: #f0e2d3; --q-line: #e6d3bf; --q-muted: #77594b; }
body.qv-pal-plum { --q-brand: #3b1f4a; --q-accent: #d9b26f; --q-ink: #1b1020; --q-ivory: #f8f4f9; --q-sand: #ece3ef; --q-line: #dfd3e4; --q-muted: #65566b; }
body.theme-raed {
  --color-primary: var(--q-brand);
  --color-primary-dark: color-mix(in srgb, var(--q-brand) 82%, #000);
  --color-primary-light: color-mix(in srgb, var(--q-brand) 78%, #fff);
  --color-primary-reverse: #ffffff;
}
body.theme-raed {
  background-color: var(--q-ivory);
  color: var(--q-ink);
  -webkit-font-smoothing: antialiased;
}
body.theme-raed.q-soft { --q-radius: 14px; }
body.theme-raed ::selection { background: var(--q-accent); color: #fff; }

/* ===== Header ===== */
.top-navbar { min-height: 0; font-size: .8rem; letter-spacing: .03em; }
.topnav-is-dark .top-navbar { background: var(--q-brand); color: #d9d2c4; }
.main-nav-container,
.main-nav-container.bg-white {
  background: var(--q-ivory);
  box-shadow: none;
  border-bottom: 1px solid var(--q-line);
}
.main-nav-container .sicon-menu,
.main-nav-container .header-btn__icon,
.main-nav-container .sicon-shopping-bag { color: var(--q-ink); }
.main-nav-container a { transition: color .25s var(--q-ease); }
.main-nav-container a:hover { color: var(--q-accent); }
.main-menu > li > a { font-weight: 600; letter-spacing: .03em; }
.main-menu > li > a::after {
  content: "";
  display: block;
  height: 1px;
  margin-top: 6px;
  background: var(--q-accent);
  transform: scaleX(0);
  transition: transform .35s var(--q-ease);
}
.main-menu > li > a:hover::after { transform: scaleX(1); }
@media (max-width: 1023px) {
  .main-nav-container .navbar-brand {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: 0;
    transform: translate(-50%, -50%);
  }
}

/* ===== Shared editorial bits ===== */
.qv-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: .75rem;
  font-size: .78rem;
  font-weight: 600;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: var(--q-accent);
}
.qv-eyebrow::before { content: ""; width: 32px; height: 1px; background: currentColor; }
.qv-title {
  font-size: clamp(1.7rem, 3.6vw, 2.7rem);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -.015em;
  margin: .6rem 0 0;
}
.qv-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 2rem;
}
.qv-link {
  font-weight: 600;
  white-space: nowrap;
  border-bottom: 1px solid currentColor;
  padding-bottom: 2px;
  transition: color .25s var(--q-ease);
}
.qv-link:hover { color: var(--q-accent); }
.qv-btn {
  display: inline-flex;
  align-items: center;
  gap: .6rem;
  padding: .95rem 1.7rem;
  border-radius: 999px;
  font-size: .95rem;
  font-weight: 600;
  line-height: 1;
  transition: background-color .3s var(--q-ease), color .3s var(--q-ease), transform .3s var(--q-ease);
}
.qv-btn:hover { transform: translateY(-2px); }
.qv-btn--solid { background: var(--q-brand); color: #fff; }
.qv-btn--solid:hover { background: var(--q-accent); color: #fff; }
.qv-btn--ghost { border: 1px solid var(--q-brand); color: var(--q-brand); }
.qv-btn--ghost:hover { background: var(--q-brand); color: #fff; }
.qv-arrow { font-size: 1.05em; }

/* ===== Hero ===== */
.qv-hero { overflow: hidden; padding: 1.5rem 0 3rem; }
.qv-hero__inner { display: grid; gap: 2rem; align-items: center; }
.qv-hero__title {
  font-size: clamp(2.4rem, 7vw, 4.8rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -.02em;
  margin: 1rem 0 0;
}
.qv-hero__desc {
  max-width: 34rem;
  margin: 1.25rem 0 2rem;
  font-size: 1.05rem;
  line-height: 1.9;
  color: var(--q-muted);
}
.qv-hero__actions { display: flex; flex-wrap: wrap; gap: .75rem; }
.qv-hero__media { position: relative; }
.qv-hero__arch {
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border-radius: 999px 999px 0 0;
  background: var(--q-sand);
}
.qv-hero__arch img { width: 100%; height: 100%; object-fit: cover; }
.qv-hero__badge {
  border: 2px solid var(--q-accent);
  position: absolute;
  bottom: 9%;
  inset-inline-start: -.5rem;
  display: grid;
  place-items: center;
  width: 112px;
  height: 112px;
  padding: .75rem;
  border-radius: 50%;
  background: var(--q-brand);
  color: #fff;
  text-align: center;
  font-size: .8rem;
  font-weight: 700;
  line-height: 1.3;
  transform: rotate(-8deg);
  box-shadow: 0 12px 30px -12px rgba(27, 26, 23, .55);
}
@media (min-width: 1024px) {
  .qv-hero { padding: 3rem 0 5rem; }
  .qv-hero__inner { grid-template-columns: 1.05fr .95fr; gap: 4rem; min-height: 640px; }
  .qv-hero__badge { inset-inline-start: -2rem; width: 132px; height: 132px; font-size: .9rem; }
}

/* ===== Marquee ===== */
.qv-marquee { overflow: hidden; background: var(--q-brand); color: #e9e2d3; padding: .95rem 0; white-space: nowrap; }
.qv-marquee__track { display: inline-flex; animation: qv-scroll 32s linear infinite; }
.qv-marquee__item { display: inline-flex; align-items: center; font-size: .85rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; }
.qv-marquee__item::after { content: "✦"; margin: 0 2rem; color: var(--q-accent); }
@keyframes qv-scroll { to { transform: translateX(-16.6667%); } }
[dir="rtl"] .qv-marquee__track { animation-name: qv-scroll-rtl; }
@keyframes qv-scroll-rtl { to { transform: translateX(16.6667%); } }

/* ===== Collections (bento) ===== */
.qv-collections { padding: 4rem 0 2rem; }
.qv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
.qv-tile {
  position: relative;
  display: block;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  border-radius: var(--q-radius-lg);
  background: var(--q-sand);
  color: #fff;
}
.qv-tile--lead { grid-column: span 2; aspect-ratio: 16 / 11; }
.qv-tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--q-ease); }
.qv-tile:hover img { transform: scale(1.06); }
.qv-tile__shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(20, 19, 16, .7), rgba(20, 19, 16, 0) 55%); }
.qv-tile__body { position: absolute; inset-inline: 1.1rem; bottom: 1.1rem; display: flex; flex-direction: column; gap: .2rem; }
.qv-tile__sub { font-size: .7rem; letter-spacing: .2em; text-transform: uppercase; opacity: .85; }
.qv-tile__title { font-size: 1.15rem; font-weight: 700; }
.qv-tile__go {
  position: absolute;
  top: 1rem;
  inset-inline-end: 1rem;
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(250, 247, 242, .92);
  color: var(--q-ink);
  transition: transform .4s var(--q-ease), background-color .3s var(--q-ease);
}
.qv-tile:hover .qv-tile__go { transform: rotate(45deg); background: var(--q-accent); color: #fff; }
@media (min-width: 1024px) {
  .qv-collections { padding: 5rem 0 3rem; }
  .qv-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 300px; gap: 1rem; }
  .qv-tile { aspect-ratio: auto; }
  .qv-tile--lead { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
  .qv-tile__title { font-size: 1.4rem; }
}

/* ===== Products ===== */
.qv-products { padding: 3rem 0 2rem; }
.qv-products .s-block__title,
.qv-products .s-slider-block__title { display: none; }
.s-product-card-entry { background: transparent; border-radius: var(--q-radius); box-shadow: none; }
.s-product-card-image { overflow: hidden; border-radius: var(--q-radius); background: var(--q-sand); }
.s-product-card-image img { transition: transform .9s var(--q-ease); }
body.theme-raed:not(.q-no-zoom) .s-product-card-entry:hover .s-product-card-image img { transform: scale(1.05); }
.s-product-card-content { padding-top: .9rem; }
.s-product-card-content-title a { font-weight: 500; letter-spacing: .005em; }
.s-product-card-promotion-title { background: var(--q-brand); color: #fff; border-radius: 0; letter-spacing: .04em; }

/* ===== Story ===== */
.qv-story { margin-top: 3rem; padding: 4rem 0; background: var(--q-sand); }
.qv-story__inner { display: grid; gap: 2.5rem; align-items: center; }
.qv-story__media { position: relative; isolation: isolate; }
.qv-story__media img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--q-radius-lg); }
.qv-story__media::after {
  content: "";
  position: absolute;
  inset: 1rem -.75rem -1rem .75rem;
  border: 1px solid var(--q-accent);
  border-radius: var(--q-radius-lg);
  z-index: -1;
}
.qv-story__p { max-width: 34rem; margin: 1.25rem 0 2rem; font-size: 1.05rem; line-height: 1.9; color: var(--q-muted); }
.qv-stats { display: flex; flex-wrap: wrap; gap: 2rem; margin: 2.25rem 0 0; padding-top: 1.5rem; border-top: 1px solid var(--q-line); }
.qv-stats dt { font-size: 1.9rem; font-weight: 800; line-height: 1.1; }
.qv-stats dd { margin: .25rem 0 0; font-size: .8rem; color: var(--q-muted); }
@media (min-width: 1024px) {
  .qv-story { padding: 6rem 0; }
  .qv-story__inner { grid-template-columns: 1fr 1fr; gap: 5rem; }
}

/* ===== Footer, forms, motion ===== */
.footer-is-dark .store-footer { background: var(--q-brand); color: #cfc8b9; }
.footer-is-dark .store-footer h3 { color: #fff; }
.footer-is-dark .store-footer a:hover { color: var(--q-accent); }
.store-footer__inner { padding-top: 3.5rem; padding-bottom: 2.5rem; }
.s-button-btn, .btn { border-radius: var(--q-radius); letter-spacing: .02em; transition: transform .25s var(--q-ease), box-shadow .25s var(--q-ease); }
.s-button-btn:hover { transform: translateY(-1px); }
.form-input, .s-form-control { border-radius: var(--q-radius); }
.form-input:focus, .s-form-control:focus { border-color: var(--q-accent); box-shadow: 0 0 0 3px rgba(169, 121, 74, .18); }
@keyframes q-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
#main-content > section { animation: q-rise .7s var(--q-ease) both; }
@media (prefers-reduced-motion: reduce) {
  #main-content > section, .s-product-card-image img, .qv-tile img, .qv-marquee__track, .qv-btn { animation: none !important; transition: none !important; }
}

/* ===== Brand-wide: Salla primary elements follow the palette ===== */
.s-button-primary,
.btn--primary { background-color: var(--q-brand); border-color: var(--q-brand); color: #fff; }
.s-button-primary:hover { background-color: var(--q-accent); border-color: var(--q-accent); color: var(--q-ink); }
.main-nav-container .sicon-menu,
.main-nav-container .header-btn__icon { color: var(--q-brand); }
.s-product-card-sale-price h4,
.s-product-card-price { color: var(--q-brand); }

/* ===== Trust promises ===== */
.qv-trust { padding: 2.5rem 0; }
.qv-trust__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 1rem; }
.qv-trust__item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .6rem; padding: 1rem .5rem; }
.qv-trust__icon {
  display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%;
  border: 1px solid var(--q-accent); color: var(--q-brand); font-size: 1.5rem;
  transition: background-color .3s var(--q-ease), color .3s var(--q-ease), transform .4s var(--q-ease);
}
.qv-trust__item:hover .qv-trust__icon { background: var(--q-brand); color: var(--q-accent); transform: translateY(-3px); }
.qv-trust__title { font-weight: 700; font-size: 1rem; margin: 0; }
.qv-trust__text { font-size: .85rem; color: var(--q-muted); margin: 0; line-height: 1.7; }
@media (min-width: 1024px) { .qv-trust__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

/* ===== Promo banner ===== */
.qv-promo { padding: 2rem 0; }
.qv-promo__panel {
  position: relative; overflow: hidden; display: flex; align-items: center; min-height: 340px;
  border-radius: var(--q-radius-lg); background-color: var(--q-brand); background-size: cover; background-position: center; color: #fff;
}
.qv-promo__panel::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, color-mix(in srgb, var(--q-brand) 92%, transparent) 0%, color-mix(in srgb, var(--q-brand) 55%, transparent) 60%, transparent 100%); }
[dir="rtl"] .qv-promo__panel::before { transform: scaleX(-1); }
.qv-promo__body { position: relative; z-index: 1; max-width: 32rem; padding: 2.5rem 1.75rem; }
.qv-promo__body .qv-eyebrow { color: var(--q-accent); }
.qv-promo__title { font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 800; line-height: 1.12; margin: .8rem 0 0; }
.qv-promo__text { margin: 1rem 0 1.75rem; line-height: 1.9; opacity: .9; }
.qv-promo .qv-btn--solid { background: var(--q-accent); color: var(--q-ink); }
.qv-promo .qv-btn--solid:hover { background: #fff; color: var(--q-ink); }
@media (min-width: 1024px) { .qv-promo__body { padding: 3.5rem; } .qv-promo__panel { min-height: 420px; } }

/* ===== Announcement bar ===== */
.qv-announce { background: var(--q-accent); color: var(--q-ink); font-size: .8rem; font-weight: 600; letter-spacing: .04em; text-align: center; padding: .5rem 0; }

/* ===== Header: centered logo ===== */
.store-header { position: relative; z-index: 30; }
.main-nav-container .navbar-brand img { max-height: 44px; }
@media (min-width: 1280px) {
  .main-nav-container .navbar-brand { position: absolute; left: 50%; top: 50%; margin: 0; transform: translate(-50%, -50%); }
}
.top-navbar .header-search { max-width: 420px; }
.top-navbar { border-bottom: 1px solid color-mix(in srgb, var(--q-ink) 8%, transparent); }

/* ===== Product card: editorial ===== */
.s-product-card-vertical .s-product-card-image,
.s-product-card-image { aspect-ratio: 4 / 5; position: relative; }
.s-product-card-image a { display: block; height: 100%; }
.s-product-card-image img { width: 100%; height: 100%; }
.s-product-card-image .s-product-card-promotion-title,
.s-product-card-image .s-product-card-quantity { position: absolute; top: .75rem; inset-inline-start: .75rem; padding: .25rem .65rem; font-size: .7rem; text-transform: uppercase; }
.s-product-card-content { padding: .9rem .15rem 0; display: flex; flex-direction: column; gap: .35rem; }
.s-product-card-content-title { margin: 0; }
.s-product-card-content-title a { font-size: .95rem; line-height: 1.5; }
.s-product-card-content-footer { margin-top: .6rem; }
.s-product-card-content .s-button-btn,
.s-product-card-content salla-button .s-button-btn {
  border-radius: 999px; border: 1px solid var(--q-brand); background: transparent; color: var(--q-brand); font-weight: 600;
  transition: background-color .3s var(--q-ease), color .3s var(--q-ease);
}
.s-product-card-content .s-button-btn:hover { background: var(--q-brand); color: #fff; transform: none; }
.s-product-card-wishlist-btn { background: rgba(255,255,255,.92) !important; }

/* ===== Product page ===== */
main h1 { font-weight: 800; letter-spacing: -.02em; line-height: 1.2; }
.total-price, .price_is_on_sale .total-price { color: var(--q-brand) !important; font-size: 1.7rem !important; font-weight: 800; }
.product__description { color: var(--q-muted); }
.product-entry__sub-title { letter-spacing: .08em; text-transform: uppercase; }
.sticky-product-bar { box-shadow: 0 -12px 30px -18px rgba(0,0,0,.35); }
.s-product-options-option-label b { letter-spacing: .02em; }

/* ===== Footer ===== */
.qv-footer .store-footer__inner { padding: 4rem 0 2rem; }
.qv-footer__hero { padding-bottom: 2.5rem; border-bottom: 1px solid color-mix(in srgb, #fff 14%, transparent); }
.qv-footer__wordmark { display: inline-block; font-size: clamp(2.6rem, 10vw, 6.5rem); font-weight: 800; line-height: 1; letter-spacing: -.035em; color: #fff; }
.qv-footer__wordmark::after { content: ""; display: block; width: 72px; height: 3px; margin-top: 1rem; background: var(--q-accent); }
.qv-footer__about { max-width: 34rem; margin: 1.5rem 0; line-height: 1.9; opacity: .8; }
.qv-footer__grid { display: grid; gap: 2rem; padding-top: 2.5rem; }
.qv-footer h3 { font-size: .8rem; letter-spacing: .2em; text-transform: uppercase; color: var(--q-accent); margin-bottom: 1rem; }
.qv-footer__bar { border-top: 1px solid color-mix(in srgb, #fff 14%, transparent); }
@media (min-width: 1024px) { .qv-footer__grid { grid-template-columns: 1fr 1fr 1.2fr; gap: 4rem; } }

/* ===== Mobile bottom navigation ===== */
.qv-bottom-nav { display: none; }
@media (max-width: 1023px) {
  body.qv-has-bottom-nav { padding-bottom: 72px; }
  .qv-bottom-nav {
    position: fixed; inset-inline: 0; bottom: 0; z-index: 40; display: flex; justify-content: space-around; align-items: stretch;
    padding: .35rem .25rem calc(.35rem + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--q-ivory) 92%, transparent);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border-top: 1px solid var(--q-line);
  }
  .qv-bn__item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: .2rem; padding: .35rem 0; font-size: .68rem; font-weight: 600; color: var(--q-muted); transition: color .25s var(--q-ease); }
  .qv-bn__item svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .qv-bn__item.is-active, .qv-bn__item:active { color: var(--q-brand); }
  .qv-bn__item.is-active::after { content: ""; width: 18px; height: 3px; border-radius: 3px; background: var(--q-accent); }
}
    </style>
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
    
    <style>
        :root {
            --font-main: '{{theme.font.name}}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
            /* Theme specific variables */
            --s-radius: .75rem;
        }
    </style>
    {% if theme.settings.get('qv_palette') == 'custom' %}
    <style>
        :root { --q-brand: {{ theme.color.primary }};{% if theme.settings.get('qv_custom_accent') %} --q-accent: {{ theme.settings.get('qv_custom_accent') }};{% endif %} }
        body.theme-raed { --q-brand: {{ theme.color.primary }};{% if theme.settings.get('qv_custom_accent') %} --q-accent: {{ theme.settings.get('qv_custom_accent') }};{% endif %} }
    </style>
    {% endif %}
    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
<body id="app" class="theme-raed overflow-x-hidden {% hook 'body:classes' %}
  {{ ' qv-pal-' ~ theme.settings.get('qv_palette', 'emerald') }}
  {{ (theme.settings.get('qv_bottom_nav', true) and page.slug != 'product.single') ? ' qv-has-bottom-nav' : '' }}
  {{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
  {{ theme.settings.get('topnav_is_dark') ? ' topnav-is-dark' : '' }}
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  {{ theme.settings.get('q_soft_corners') ? ' q-soft' : '' }}
  {{ theme.settings.get('q_hover_zoom', true) ? '' : ' q-no-zoom' }}
  ">
<noscript>
    To get full functionality of this site you need to enable JavaScript. Here is how
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">To enable JavaScript on webpage</a>.
</noscript>
<div class="app-inner flex flex-col min-h-full">
    {% hook 'body:start' %}
    {% component 'header.header' %}
    <main id="main-content" role="main"{{ (page.slug == 'product.single' or page.slug starts with 'product.index') ? ' class="flex flex-col space-y-8 sm:space-y-16"' : '' }}>
    {% block content %}{% endblock %}
    </main>
    {% component 'footer.footer' %}
</div>
{% if theme.settings.get('qv_bottom_nav', true) and page.slug != 'product.single' %}
{% set qv_ar = language.code == 'ar' %}
<nav class="qv-bottom-nav" aria-label="bottom navigation">
    <a class="qv-bn__item {{ is_page('index') ? 'is-active' : '' }}" href="{{ link('/') }}">
        <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
        <span>{{ qv_ar ? 'الرئيسية' : 'Home' }}</span>
    </a>
    <a class="qv-bn__item" data-qv-path="products" href="{{ link('products') }}">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        <span>{{ qv_ar ? 'المنتجات' : 'Shop' }}</span>
    </a>
    <a class="qv-bn__item" data-qv-path="customer/wishlist" href="{{ link('customer/wishlist') }}">
        <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-9-9a5 5 0 0 1 9-3 5 5 0 0 1 9 3c-2 4.6-9 9-9 9z"/></svg>
        <span>{{ qv_ar ? 'المفضلة' : 'Wishlist' }}</span>
    </a>
    <a class="qv-bn__item" data-qv-path="cart" href="{{ link('cart') }}">
        <svg viewBox="0 0 24 24"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span>{{ qv_ar ? 'السلة' : 'Cart' }}</span>
    </a>
    <a class="qv-bn__item" data-qv-path="customer/profile" href="{{ link('customer/profile') }}">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg>
        <span>{{ qv_ar ? 'حسابي' : 'Account' }}</span>
    </a>
</nav>
<script>
    (function () {
        function setLinks() {
            if (!window.salla || !salla.url) return;
            document.querySelectorAll('.qv-bn__item[data-qv-path]').forEach(function (a) {
                try { a.href = salla.url.get(a.getAttribute('data-qv-path')); } catch (e) {}
            });
        }
        document.addEventListener('theme::ready', setLinks);
        window.addEventListener('load', function () { setTimeout(setLinks, 600); });
    })();
</script>
{% endif %}
{% hook 'body:end' %}
{% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight Components #}
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>
<salla-login-modal data-testid="store-login-modal"></salla-login-modal>
{% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
