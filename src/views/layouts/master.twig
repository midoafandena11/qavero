{# Qavero - master layout (based on Salla Theme Raed, MIT) #}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}


    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = "{{ theme.settings.get('enable_more_menu', true) }}"
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', true) }}"
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}"
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <style id="qavero-style">
:root {
  --q-ink: #1b1a17;
  --q-ivory: #faf7f2;
  --q-sand: #efe8dc;
  --q-line: #e4dccd;
  --q-bronze: #a9794a;
  --q-radius: 2px;
  --q-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
}
body.theme-raed {
  background-color: var(--q-ivory);
  color: var(--q-ink);
  -webkit-font-smoothing: antialiased;
}
body.theme-raed ::selection { background: var(--q-bronze); color: #fff; }

.topnav-is-dark .top-navbar { background: var(--q-ink); color: #d9d2c4; }
.main-nav-container,
.main-nav-container.bg-white {
  background: var(--q-ivory);
  box-shadow: none;
  border-bottom: 1px solid var(--q-line);
}
.main-nav-container a { transition: color 0.25s var(--q-ease); }
.main-nav-container a:hover { color: var(--q-bronze); }

.s-block__title h2,
.s-block-title { font-weight: 700; letter-spacing: -0.01em; }
.s-block__title h2::after,
.s-block-title::after {
  content: "";
  display: block;
  width: 44px;
  height: 2px;
  margin-top: 10px;
  background: var(--q-bronze);
}
.s-block__title { margin-bottom: 1.75rem; }

.s-button-btn,
.btn {
  border-radius: var(--q-radius);
  letter-spacing: 0.02em;
  transition: transform 0.25s var(--q-ease), box-shadow 0.25s var(--q-ease);
}
.s-button-btn:hover { transform: translateY(-1px); }
.s-button-primary { box-shadow: 0 6px 18px -8px rgba(27, 26, 23, 0.45); }

.s-product-card-entry {
  background: transparent;
  border-radius: var(--q-radius);
  box-shadow: none;
}
.s-product-card-image {
  overflow: hidden;
  border-radius: var(--q-radius);
  background: var(--q-sand);
}
.s-product-card-image img { transition: transform 0.9s var(--q-ease); }
.s-product-card-entry:hover .s-product-card-image img { transform: scale(1.05); }
.s-product-card-content { padding-top: 0.9rem; }
.s-product-card-content-title a { font-weight: 500; letter-spacing: 0.005em; }
.s-product-card-promotion-title {
  background: var(--q-ink);
  color: #fff;
  border-radius: 0;
  letter-spacing: 0.04em;
}

.footer-is-dark .store-footer { background: var(--q-ink); color: #cfc8b9; }
.footer-is-dark .store-footer h3 { color: #fff; }
.footer-is-dark .store-footer a:hover { color: var(--q-bronze); }
.store-footer__inner { padding-top: 3.5rem; padding-bottom: 2.5rem; }

.form-input,
.s-form-control { border-radius: var(--q-radius); }
.form-input:focus,
.s-form-control:focus {
  border-color: var(--q-bronze);
  box-shadow: 0 0 0 3px rgba(169, 121, 74, 0.18);
}

@keyframes q-rise {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: none; }
}
#main-content > section,
#main-content .s-block { animation: q-rise 0.7s var(--q-ease) both; }
@media (prefers-reduced-motion: reduce) {
  #main-content > section,
  #main-content .s-block,
  .s-product-card-image img,
  .s-button-btn { animation: none !important; transition: none !important; }
}
    </style>
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
    
    <style>
        :root {
            --font-main: '{{theme.font.name}}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
            /* Theme specific variables */
            --s-radius: .75rem;
        }
    </style>
    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
<body id="app" class="theme-raed overflow-x-hidden {% hook 'body:classes' %}
  {{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
  {{ theme.settings.get('topnav_is_dark') ? ' topnav-is-dark' : '' }}
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  ">
<noscript>
    To get full functionality of this site you need to enable JavaScript. Here is how
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">To enable JavaScript on webpage</a>.
</noscript>
<div class="app-inner flex flex-col min-h-full">
    {% hook 'body:start' %}
    {% component 'header.header' %}
    <main id="main-content" role="main"{{ (page.slug == 'product.single' or page.slug starts with 'product.index') ? ' class="flex flex-col space-y-8 sm:space-y-16"' : '' }}>
    {% block content %}{% endblock %}
    </main>
    {% component 'footer.footer' %}
</div>
{% hook 'body:end' %}
{% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight Components #}
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>
<salla-login-modal data-testid="store-login-modal"></salla-login-modal>
{% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
